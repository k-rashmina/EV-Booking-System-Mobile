<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- STATE 1: When the EditText is focused (selected) -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <!-- You can make the inside white when focused -->
            <solid android:color="@android:color/white" />
            <corners android:radius="12dp" />
            <!-- Use a thicker, green stroke when focused -->
            <stroke android:width="2dp" android:color="@color/logo_green" />
        </shape>
    </item>

    <!-- STATE 2: The default, unfocused state -->
    <item>
        <shape android:shape="rectangle">
            <!-- A very light grey background for the unfocused state -->
            <solid android:color="#F5F5F5" />
            <corners android:radius="12dp" />
            <!-- A standard grey, thin stroke for the unfocused state -->
            <stroke android:width="1dp" android:color="#DDDDDD" />
        </shape>
    </item>

</selector>

